{
  "permissions": {
    "deny": [
      "Bash(shutdown)",
      "Bash(shutdown:*)",
      "Bash(poweroff)",
      "Bash(poweroff:*)",
      "Bash(halt:*)",
      "Bash(reboot:*)",
      "Bash(/usr/bin/shutdown:*)",
      "Bash(/usr/sbin/poweroff:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-poweroff.sh"
          }
        ]
      }
    ]
  }
}
