# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Test, lint, type-check, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Packaging artifacts
build/
dist/
*.egg-info/

# Training artifacts. Metrics and the clean per-run logs are tracked so results
# reach other devices through git; checkpoints, forecast pickles and the raw
# runner transcript (one huge \r-laden line) stay on the GPU host.
output/*
!output/log/
!output/metrics/
# why the host went down last time; small, and worth having on every device
!output/last_run.json
output/log/*
!output/log/*.log
output/log/run_3seeds_*.log
output/metrics/*
!output/metrics/*.csv
output_remote/

# Machine-local remote-dev config (SSH host, paths) — see scripts/remote_dev.sh
.remote-dev.env

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# sing-box (autodl-proxy) writes its bbolt cache into whatever cwd `proxy_on`
# was run from; nothing to do with this repo. Fix at the source by setting
# experimental.cache_file.path in /etc/autodl-proxy/*.json.
cache.db
# merge/rebase leftovers
*.orig
*.rej
