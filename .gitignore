# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Test, lint, type-check, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Packaging artifacts
build/
dist/
*.egg-info/

# Training artifacts. Metrics, the clean per-run logs and the best-val
# checkpoints are tracked so results reach other devices through git; forecast
# pickles and the raw runner transcript (one huge \r-laden line, regenerable)
# stay on the GPU host.
output/*
!output/log/
!output/metrics/
# why the host went down last time; small, and worth having on every device
!output/last_run.json
output/log/*
!output/log/*.log
output/log/run_3seeds_*.log
output/metrics/*
!output/metrics/*.csv

# Best-val checkpoints are tracked: 4.5 MB each, and training is NOT bit-wise
# reproducible (cudnn.benchmark is left on, no use_deterministic_algorithms), so
# a lost checkpoint cannot be regenerated -- only re-trained at ~9 h/seed. They
# are what lets a finished run be re-tested under a different sampling protocol
# (see reproduction_note.md, 2026-08-29). !output/model/ must come first: once a
# directory is excluded, git cannot un-ignore files inside it.
!output/model/
output/model/*
!output/model/*.dm4stg
# per-epoch crash snapshot; superseded by the best checkpoint once a run finishes
output/model/*.last.dm4stg
# smoke-test artifacts (2-epoch model, mae 345)
output/model/test_*.dm4stg
output_remote/

# Machine-local remote-dev config (SSH host, paths) — see scripts/remote_dev.sh
.remote-dev.env

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# sing-box (autodl-proxy) writes its bbolt cache into whatever cwd `proxy_on`
# was run from; nothing to do with this repo. Fix at the source by setting
# experimental.cache_file.path in /etc/autodl-proxy/*.json.
cache.db
# merge/rebase leftovers
*.orig
*.rej
